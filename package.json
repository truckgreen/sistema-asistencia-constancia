{
  "name": "sistema-asistencia-constancia",
  "description": "Sistema de Control de Asistencias, Horarios y Agenda del Personal - U.E. La Constancia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "start": "node server.ts",
    "db:push": "node node_modules/drizzle-kit/bin.cjs push --force --config=src/db/drizzle.config.ts",
    "preview": "vite preview --port 3000",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0"
  }
